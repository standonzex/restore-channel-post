diff --git a/submodules/TelegramUI/Components/Chat/ChatRecentActionsController/Sources/ChannelPostRecovery.swift b/submodules/TelegramUI/Components/Chat/ChatRecentActionsController/Sources/ChannelPostRecovery.swift
